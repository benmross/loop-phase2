  <version>0.1.0</version>
  <description>Mission messages and services between the S1 operator console and the mission manager</description>
  <maintainer email="ben.m.ross08@gmail.com">Ben Ross</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
